# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.env
.prod.env
.venv/
venv/
env/
ENV/

# MacOS
.DS_Store

# Unit test / coverage
.coverage
.cache/
pytest_cache/
htmlcov/
.tox/
.nox/

# IDEs and editors
.vscode/
.idea/

# mypy / pyright / pylance
.mypy_cache/
.pyright/

# Jupyter notebooks
*.ipynb_checkpoints

# Docker secrets
/secrets/*

# terraform
# Terraform .terraform directory
.terraform/

# Terraform state files and backups
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*.tfplan.out

# Terraform variable definition files (if sensitive data is present)
*.tfvars
*.tfvars.json

# Crash log files
crash.log

# Specific provider cache directories (if not handled by .terraform/)
# For example, for AWS provider:
# .terraform/plugins/linux_amd64/hashicorp/aws/